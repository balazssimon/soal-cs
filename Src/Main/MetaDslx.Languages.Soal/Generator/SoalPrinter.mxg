namespace MetaDslx.Languages.Soal.Generator;

using System;
using System.Collections.Generic;
using System.Linq;
using MetaDslx.Modeling;
using MetaDslx.Languages.Soal.Symbols;

generator SoalPrinter;

template Generate(IEnumerable<Namespace> namespaces)
	[foreach (var ns in namespaces)]
	[GenerateNamespace(ns)]
	[end foreach]
end template

template GenerateNamespace(Namespace ns)
	[if (ns.Declarations.Where(d => !(d is Namespace)).Count() > 0)]
		[if (ns.Prefix != null)]
		namespace [ns.FullName] = [ns.Prefix]:"[ns.Uri]"
		[else]
		namespace [ns.FullName] = "[ns.Uri]"
		[end if]
		{
			[foreach (var enm in ns.Declarations.OfType<Symbols.Enum>())]
				[GenerateEnum(ns, enm)]

			[end foreach]
			[foreach (var st in ns.Declarations.OfType<Symbols.Struct>())]
				[GenerateStruct(ns, st)]

			[end foreach]
			[foreach (var intf in ns.Declarations.OfType<Symbols.Interface>())]
				[GenerateInterface(ns, intf)]

			[end foreach]
			[foreach (var bnd in ns.Declarations.OfType<Symbols.Binding>())]
				[GenerateBinding(ns, bnd)]

			[end foreach]
			[foreach (var endp in ns.Declarations.OfType<Symbols.Endpoint>())]
				[GenerateEndpoint(ns, endp)]

			[end foreach]
		}

	[end if]
end template

template GenerateDocumentation(DocumentedElement de)
	[foreach (var line in de.GetDocumentationLines())]
		/// [line]
	[end foreach]
end template

template GenerateAnnotations(AnnotatedElement ae, bool isReturn)
	[foreach (var annot in ae.Annotations)]
		["["][isReturn ? "return: " : ""][annot.Name][if(annot.Properties.Count > 0)]([GenerateAnnotationProperties(annot)])[end if]["]"]
	[end foreach]
end template

template GenerateAnnotationsSingleLine(AnnotatedElement ae, bool isReturn)
	[-]
	[foreach (var annot in ae.Annotations)]
		["["][isReturn ? "return: " : ""][annot.Name][if(annot.Properties.Count > 0)]([GenerateAnnotationProperties(annot)])[end if]["] "]
	[end foreach]
end template

template GenerateAnnotationProperties(Annotation annot)
	[-]
	[foreach (var prop in annot.Properties) separator ", "]
		[prop.Name]=[GetAnnotationPropertyValue(prop)]
	[end foreach]
end template

template GenerateEnum(Namespace currentNs, Symbols.Enum enm)
	[GenerateDocumentation(enm)]
	[GenerateAnnotations(enm, false)]
	enum [enm.Name][GetAncestor(currentNs, enm)]
	{
		[for (int i = 0; i < enm.EnumLiterals.Count; ++i)]
			[var lit = enm.EnumLiterals[i]]
			[GenerateEnumLiteral(currentNs, lit, i+1 < enm.EnumLiterals.Count ? "," : "")]
		[end for]
	}
end template

template GenerateEnumLiteral(Namespace currentNs, EnumLiteral lit, string delim)
	[GenerateDocumentation(lit)]
	[GenerateAnnotations(lit, false)]
	[lit.Name][delim]
end template

template GenerateStruct(Namespace currentNs, Struct st)
	[GenerateDocumentation(st)]
	[GenerateAnnotations(st, false)]
	struct [st.Name][GetAncestor(currentNs, st)]
	{
		[foreach (var prop in st.Properties)]
			[GenerateProperty(currentNs, prop)]
		[end foreach]
	}
end template

template GenerateProperty(Namespace currentNs, Property prop)
	[GenerateDocumentation(prop)]
	[GenerateAnnotations(prop, false)]
	[GenerateType(currentNs, prop.Type)] [prop.Name];
end template

template GenerateRef(Namespace currentNs, Declaration decl)
	[-]
	[if (decl != null)]
		[if (decl.Namespace != currentNs)]
			[decl.FullName]
		[else]
			[decl.Name]
		[end if]
	[end if]
end template

template GenerateType(Namespace currentNs, SoalType t)
	[-]
	[if (t is PrimitiveType)]
		[((PrimitiveType)t).Name]
	[else if (t is NullableType)]
		[GenerateType(currentNs, ((NullableType)t).InnerType)]?
	[else if (t is ArrayType)]
		[GenerateType(currentNs, ((ArrayType)t).InnerType)]["[]"]
	[else if (t is Declaration)]
		[GenerateRef(currentNs, (Declaration)t)]
	[else]
		[t]
	[end if]
end template

template GenerateReturnType(Namespace currentNs, Operation op)
	[-]
	[if (op.Result.IsOneway)]
		oneway
	[else]
		[GenerateType(currentNs, op.Result.Type)]
	[end if]
end template

template GenerateThrows(Namespace currentNs, Operation op)
	[-]
	[if (op.Exceptions.Count > 0)]
	 throws 
		[foreach (var ex in op.Exceptions) separator ", "]
			[GenerateType(currentNs, ex)]
		[end foreach]
	[end if]
end template

template GenerateParameters(Namespace currentNs, Operation op)
	[-]
	[foreach (var p in op.Parameters) separator ", "]
		[GenerateAnnotationsSingleLine(p, false)][GenerateType(currentNs, p.Type)] [p.Name]
	[end foreach]
end template

template GenerateOperation(Namespace currentNs, Operation op)
	[GenerateDocumentation(op)]
	[GenerateAnnotations(op, false)]
	[GenerateAnnotations(op.Result, true)]
	[GenerateReturnType(currentNs, op)] [op.Name]([GenerateParameters(currentNs, op)])[GenerateThrows(currentNs, op)];
end template

template GenerateInterface(Namespace currentNs, Interface intf)
	[GenerateDocumentation(intf)]
	[GenerateAnnotations(intf, false)]
	interface [intf.Name]
	{
		[foreach (var op in intf.Operations)]
			[GenerateOperation(currentNs, op)]
		[end foreach]
	}
end template

template GenerateTransportBinding(Namespace currentNs, TransportBindingElement bnd)
	[if (bnd is HttpTransportBindingElement htbe)]
		[if (htbe.Ssl)]
			transport HTTP
			{
				Ssl = true;
				ClientAuthentication = [htbe.ClientAuthentication.ToString().ToLower()];
			}
		[else]
			transport HTTP;
		[end if]
	[else if (bnd is RestTransportBindingElement rtbe)]
		transport REST;
	[else if (bnd is WebSocketTransportBindingElement wtbe)]
		transport WebSocket;
	[end if]
end template

template GenerateEncodingBinding(Namespace currentNs, EncodingBindingElement bnd)
	[if (bnd is SoapEncodingBindingElement sebe)]
		[if (sebe.Style != SoapEncodingStyle.DocumentWrapped || sebe.Version != SoapVersion.Soap11 || sebe.Mtom)]
			encoding SOAP
			{
				[if (sebe.Style != SoapEncodingStyle.DocumentWrapped)]
				Style = [sebe.Style];
				[end if]
				[if (sebe.Version != SoapVersion.Soap11)]
				Version = [sebe.Version];
				[end if]
				[if (sebe.Mtom)]
				Mtom = true;
				[end if]
			}
		[else]
			encoding SOAP;
		[end if]
	[else if (bnd is XmlEncodingBindingElement xebe)]
		encoding XML;
	[else if (bnd is JsonEncodingBindingElement jebe)]
		encoding JSON;
	[end if]
end template

template GenerateProtocolBinding(Namespace currentNs, ProtocolBindingElement bnd)
	[if (bnd is WsAddressingBindingElement)]
		protocol WsAddressing;
	[end if]
end template

template GenerateBinding(Namespace currentNs, Symbols.Binding bnd)
	binding [bnd.Name]
	{
		[GenerateTransportBinding(currentNs, bnd.Transport)]
		[foreach (var enc in bnd.Encodings)]
			[GenerateEncodingBinding(currentNs, enc)]
		[end foreach]
		[foreach (var prot in bnd.Protocols)]
			[GenerateProtocolBinding(currentNs, prot)]
		[end foreach]
	}
end template

template GenerateEndpoint(Namespace currentNs, Endpoint endp)
	endpoint [endp.Name] : [GenerateRef(currentNs, endp.Interface)]
	{
		binding [GenerateRef(currentNs, endp.Binding)];
		address "[endp.Address]";
	}
end template
